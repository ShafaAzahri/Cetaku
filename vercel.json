{
    "name": "cetaku",
    "version": 2,
    "regions": ["sin1"],
    "builds": [
        {
            "src": "vercel.php",
            "use": "vercel-php@0.6.2"
        },
        {
            "src": "/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(css|js|images|fonts|vendor)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/vercel.php"
        }
    ],
    "env": {
        "APP_KEY": "base64:bIi0CIAfQtLQoYP+QGBxNi4tqZKfD9Y8l/iNTjKfrX8=",
        "APP_URL": "https://cetaku.vercel.app",
        "API_URL": "https://cetaku.vercel.app/api",
        "DB_CONNECTION": "mysql",
        "DB_HOST": "gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com",
        "DB_PORT": "4000",
        "DB_DATABASE": "cetakufinal",
        "DB_USERNAME": "3o5Akw4HFcKSThg.root",
        "DB_PASSWORD": "lk2KiEXIQu7iPAFJ",
        "DB_SSLMODE": "require",
        "MIDTRANS_SERVER_KEY": "SB-Mid-server-ENGNOvmSgF89Mn1dX9Yi9DF3",
        "MIDTRANS_CLIENT_KEY": "SB-Mid-client-7EVtWEvtXKmKwQME",
        "MIDTRANS_IS_PRODUCTION": "false",
        "RAJA_ONGKIR_KEY": "1lqUxKEg96417958f373f40bq5fG5Er7",
